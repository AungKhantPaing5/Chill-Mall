# ==================================================
# CHILL MALL - ENVIRONMENT CONFIGURATION TEMPLATE
# ==================================================
# Copy this file to .env and fill in real values.
# NEVER commit your real .env file to GitHub.

# Application
APP_URL=https://chillmall.example.com
NEXT_PUBLIC_APP_URL=https://chillmall.example.com
NODE_ENV=production

# Database (PostgreSQL)
POSTGRES_USER=chillmall
POSTGRES_PASSWORD=replace_with_strong_db_password
POSTGRES_DB=chillmall
DATABASE_URL=postgresql://chillmall:replace_with_strong_db_password@postgres:5432/chillmall?schema=public

# Redis (Queue & Cache)
REDIS_PASSWORD=replace_with_strong_redis_password
REDIS_URL=redis://:replace_with_strong_redis_password@redis:6379

# Authentication & Security
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace_with_32_byte_random_secret
STREAM_SIGNING_SECRET=replace_with_another_32_byte_random_secret

# Initial Super Admin (used only by prisma/seed.ts)
SEED_ADMIN_EMAIL=admin@chillmall.example.com
SEED_ADMIN_PASSWORD=ChangeMeNow!2026

# Internationalization
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,my

# Hybrid Storage Configuration
STORAGE_MODE=local
LOCAL_STORAGE_PATH=/data/media
TMP_PROCESSING_PATH=/data/tmp

# S3 / Cloudflare R2 / S3-Compatible Provider
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_CDN_URL=

# Google AdSense
ADSENSE_PUBLISHER_ID=

# SMTP Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Chill Mall <no-reply@chillmall.example.com>"
